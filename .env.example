# BharatCode AI Configuration
# Base URL for BharatCode model inference
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
# API key obtained from BharatCode platform
BHARATCODE_API_KEY=your_bharatcode_api_key_here
# Model identifier (default: qwen-3.8-27b)
BHARATCODE_MODEL=qwen-3.8-27b

# GitHub API Integration (Optional for public issues, helps avoid rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./ossquest.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sandbox Security Settings
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=512
ENABLE_NETWORK_IN_SANDBOX=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
